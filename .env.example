# Report download form emails (see lib/report-email.ts)
RESEND_API_KEY=
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=

# Sanity (see sanity/env.ts). Without these the site serves lib/content.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Live domain, for link previews and share links (see lib/site-url.ts).
NEXT_PUBLIC_SITE_URL=

# Site assistant (see app/api/chat/route.ts). Key from console.groq.com;
# the free plan is enough. GROQ_MODEL is optional.
GROQ_API_KEY=
GROQ_MODEL=
